<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="28" />
    <uses-feature android:name="android.hardware.vulkan.level" android:version="1" android:required="false" />
    <uses-feature android:glEsVersion="0x00030000" android:required="true" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <uses-feature android:name="android.software.leanback" android:required="false" />

    <application
        android:name="${applicationName}"
        android:label="CRAFTIX"
        android:appCategory="game"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:usesCleartextTraffic="false">
        <!-- Flutter's Android embedding v2; required by `flutter build apk`. -->
        <meta-data android:name="flutterEmbedding" android:value="2" />

        <!-- Flutter is the real launcher host: always portrait. -->
        <activity
            android:name="dev.horizon.android.MainActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|density|screenLayout|fontScale"
            android:windowSoftInputMode="adjustResize"
            android:hardwareAccelerated="true"
            android:theme="@style/LaunchTheme" />

        <!-- Existing launcher shortcuts keep working; they now open Flutter. -->
        <activity-alias
            android:name="com.google.androidgamesdk.GameActivity"
            android:targetActivity="dev.horizon.android.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- The game keeps its stock NativeActivity, Rust wgpu/Vulkan surface
             and its own rotation policy (landscape allowed while playing).
             It lives in a separate process because android_main ends with
             std::process::exit(0); that must never kill the Flutter host. -->
        <activity
            android:name="dev.horizon.android.HorizonActivity"
            android:exported="false"
            android:process=":engine"
            android:screenOrientation="unspecified"
            android:configChanges="orientation|screenSize|keyboardHidden|keyboard|density|screenLayout"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/HorizonGameTheme">
            <meta-data android:name="android.app.lib_name" android:value="horizon_android" />
        </activity>

        <provider
            android:name="dev.horizon.android.HorizonDocumentsProvider"
            android:authorities="${applicationId}.documents"
            android:exported="true"
            android:grantUriPermissions="true"
            android:permission="android.permission.MANAGE_DOCUMENTS">
            <intent-filter>
                <action android:name="android.content.action.DOCUMENTS_PROVIDER" />
            </intent-filter>
        </provider>
    </application>
</manifest>
